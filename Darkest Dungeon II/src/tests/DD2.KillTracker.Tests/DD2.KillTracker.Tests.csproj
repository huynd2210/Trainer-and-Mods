<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner: no NuGet, no network. Compiles the game-independent Core classes straight
       into the test assembly, so nothing from Unity or the game is needed to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DD2.KillTracker.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\DD2.KillTracker\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
