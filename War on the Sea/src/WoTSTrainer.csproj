<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WoTSTrainer</AssemblyName>
    <RootNamespace>WoTSTrainer</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.3.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\out\</OutputPath>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <!-- Provides .NET Framework 3.5 reference assemblies so the .NET 8 SDK can compile net35 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies (Unity 5.6 Mono / mscorlib 2.0.0.0) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\game\WarOnTheSea_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\game\WarOnTheSea_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\game\WarOnTheSea_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BepInEx 5 runtime -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\tools\bepinex\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\tools\bepinex\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
